# ==========================================================
# GEBYAR MATEMATIKA ONLINE 2026 - ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env.local untuk development lokal,
# dan daftarkan key-key ini di menu Project Settings > Environment Variables di Vercel.
# ==========================================================

# 1. MIDTRANS CONFIGURATION
# Dapatkan dari Dashboard Midtrans (Settings > Access Keys)
# Client Key (Aman untuk frontend):
VITE_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"

# Server Key (Wajib RAHASIA, hanya untuk Backend Serverless Vercel):
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"

# Ubah ke "true" jika sudah akun Midtrans LIVE / Real Money. Gunakan "false" untuk mode Sandbox.
MIDTRANS_IS_PRODUCTION="false"

# 2. SUPABASE CONFIGURATION
# Dapatkan dari Dashboard Supabase (Project Settings > API)
VITE_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Anon Key (Public Key untuk client browser):
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Service Role Secret Key (Wajib RAHASIA untuk webhook dan serverless update):
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. APP SETTINGS
VITE_APP_URL="https://gebyarmatematika.vercel.app"
